---
import projects from '../../projects.json';

export function getStaticPaths() {
    return projects.map(project => ({ params: { project: project.slug } }));
}

const { project: projectSlug } = Astro.params;
const project = projects.find((p) => p.slug === projectSlug);

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// Cloudflare Image Resizing helper
const USE_CLOUDFLARE_IMAGE_RESIZING = true;

const generateCloudflareImageUrl = (src: string, width: number, height?: number, fit: string = 'cover'): string => {
  if (!USE_CLOUDFLARE_IMAGE_RESIZING) {
    return src;
  }
  
  if (src.startsWith('/')) {
    const heightParam = height ? `,height=${height}` : '';
    return `/cdn-cgi/image/width=${width}${heightParam},fit=${fit},quality=85,format=auto${src}`;
  }
  
  if (src.startsWith('http://') || src.startsWith('https://')) {
    try {
      const url = new URL(src);
      if (url.hostname === 'www.skapari.co.za' || url.hostname === 'skapari.co.za') {
        const heightParam = height ? `,height=${height}` : '';
        return `/cdn-cgi/image/width=${width}${heightParam},fit=${fit},quality=85,format=auto${url.pathname}`;
      }
    } catch (e) {
      // Invalid URL, fallback to original
    }
  }
  
  return src;
};

// Optimize project images
const optimizedImages = project?.images?.map((img, idx) => {
  if (idx === 0) {
    // First image: full width, larger size
    return {
      original: img,
      optimized: generateCloudflareImageUrl(img, 1200),
      srcset: `${generateCloudflareImageUrl(img, 1200)} 1x, ${generateCloudflareImageUrl(img, 2400)} 2x`
    };
  } else {
    // Thumbnail images: smaller size
    return {
      original: img,
      optimized: generateCloudflareImageUrl(img, 400, 300),
      srcset: `${generateCloudflareImageUrl(img, 400, 300)} 1x, ${generateCloudflareImageUrl(img, 800, 600)} 2x`
    };
  }
}) || [];
---
<Layout title={project ? `${project.name} - Skapari` : 'Project Not Found - Skapari'}>
  <Nav navclass="header"/>
  <section class="container">
    {project ? (
      <>
        <div class="row">
          <div class="col-md-10 offset-md-1 heading">
            <h3 class="skapari-heading {project.category}">
              {project.category}
              <span>  {project.name}</span>
            </h3>
            {project.status && (
              <div class="mb-2"><strong>Status:</strong> {project.status}</div>
            )}
          </div>
        </div>
        <div class="row">
          <div class="col-md-10 offset-md-1">
            {'description' in project && project.description && <p class="well">{project.description}</p>}
            <div class="row">
              {optimizedImages.length > 0 ? (
                optimizedImages.map((imgData, idx) => (
                  <div class={idx === 0 ? 'col-lg-12' : 'project-thumb col-lg-3 col-md-4 col-sm-4 col-6 mt-4'}>
                    <div class="bg-image hover-overlay">
                      <a href={imgData.original} data-fslightbox>
                        <img 
                          src={imgData.optimized} 
                          srcset={imgData.srcset}
                          class="w-100" 
                          loading={idx === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                          width={idx === 0 ? 1200 : 400}
                          height={idx === 0 ? undefined : 300}
                          alt={`${project.name} - Image ${idx + 1}`}
                        />
                      </a>
                    </div>
                  </div>
                ))
              ) : (
                <div class="col-12">
                  <img 
                    src={project.img ? generateCloudflareImageUrl(project.img, 1200) : project.img} 
                    class="w-100" 
                    alt={project.name}
                    loading="eager"
                  />
                </div>
              )}
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-md-10 offset-md-1 text-right">
            <a class="nav-link p-2 m-5" href="/projects">&#8592; back to our work</a>
          </div>
        </div>
      </>
    ) : (
      <div class="row">
        <div class="col-md-10 offset-md-1">
          <h2>Project Not Found</h2>
          <a class="nav-link p-2 m-5" href="/projects">&#8592; back to our work</a>
        </div>
      </div>
    )}
  </section>
  <Footer/>
</Layout>
<style>
  .project-thumb img {
    width: 100%;
    max-height: 150px;
    object-fit: cover;
  }
</style>
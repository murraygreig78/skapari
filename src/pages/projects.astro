---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectGrid from '../components/ProjectGrid.svelte';
import projectsData from '../projects.json';

// Extract unique categories from projects
const categories = [];
const categoryMap = new Map();

projectsData.forEach(project => {
  if (project.category && !categoryMap.has(project.category.toLowerCase())) {
    categoryMap.set(project.category.toLowerCase(), {
      id: project.category.toLowerCase(),
      label: project.category
    });
  }
});

categories.push(...categoryMap.values());

// Optimize project images for thumbnails using Cloudflare Image Resizing
// Thumbnail size: 600px width (2x for retina = 1200px max)
// Height: 300px (2x for retina = 600px max)
const optimizedProjects = projectsData.map(project => {
  const thumbnailSrc = project.images && project.images.length > 0 
    ? project.images[0] 
    : project.img;
  
  // Cloudflare Image Resizing API format:
  // /cdn-cgi/image/width=W,height=H,fit=cover,quality=Q,format=auto/path/to/image.jpg
  // format=auto serves WebP/AVIF when supported by browser
  // quality=85 provides good balance between size and quality
  
  const generateCloudflareImageUrl = (src: string, width: number, height: number): string => {
    // Cloudflare Image Resizing works on same-origin images
    // For relative paths, apply Cloudflare resizing
    if (src.startsWith('/')) {
      return `/cdn-cgi/image/width=${width},height=${height},fit=cover,quality=85,format=auto${src}`;
    }
    // For absolute URLs from same domain, extract path and apply resizing
    if (src.startsWith('http://') || src.startsWith('https://')) {
      try {
        const url = new URL(src);
        // Only optimize if it's from the same domain (skapari.global)
        if (url.hostname === 'www.skapari.global' || url.hostname === 'skapari.global') {
          return `/cdn-cgi/image/width=${width},height=${height},fit=cover,quality=85,format=auto${url.pathname}`;
        }
      } catch (e) {
        // Invalid URL, fallback to original
      }
    }
    // Fallback to original for external or invalid URLs
    return src;
  };
  
  // Generate optimized URLs for 1x and 2x (retina) displays
  const src1x = generateCloudflareImageUrl(thumbnailSrc, 600, 300);
  const src2x = generateCloudflareImageUrl(thumbnailSrc, 1200, 600);
  
  // Generate srcset for responsive images
  const srcset = `${src1x} 1x, ${src2x} 2x`;
  
  return {
    ...project,
    thumbnail: {
      src: src1x,
      srcset: srcset,
      // Dimensions for layout stability (prevents CLS)
      width: 600,
      height: 300
    }
  };
});
---

<Layout title="Projects - Skapari">
  <div class="wrapper">
    <header class="header bg-dark">
      <Nav />
    </header>
    
    <section class="section bg-dark" id="projects">
      <div class="container-fluid">
        <div class="overlay-content">
          <h1 class="text-right main-heading">projects</h1>
        </div>
      </div>
    </section>

    <ProjectGrid client:load projects={optimizedProjects} categories={categories} />
  </div>
  <Footer />
</Layout>

<style>
  /* Add any page-specific styles here */
</style> 
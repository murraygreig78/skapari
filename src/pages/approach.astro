---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import circleLightsLeft from '../assets/images/circle_lights_left.png';
import circleLightsBottom from '../assets/images/circle_lights_bottom.png';
import jackyRiejean from '../assets/images/jacky_riejean1.png';
import skapariCurated from '../assets/images/skapari_curated.png';
import curatedLogo from '../assets/images/curated logo.png';
import radissonLogo from '../assets/images/radisson-logo 1.png';
import accorLogo from '../assets/images/Accor-Logo 1.png';

const stats = [
  { value: '10+', label: 'Countries of project experience' },
  { value: '20+', label: 'Years designing hospitality' },
  { value: '2', label: 'Studios in Johannesburg & Cape Town' },
  { value: 'Africa & Middle East', label: 'Regions of deep design focus' },
];

const expertise = [
  {
    title: 'Hotels',
    body: 'We design hotels, resorts and hospitality destinations that feel rooted in place. From luxury and lifestyle brands to soft refurbishments, our work balances brand standards with local identity, guest comfort and operational clarity.',
  },
  {
    title: 'Apartments',
    body: 'Apartments are designed and built in collaboration with the same sensitivity given to the creative process — considered interiors that balance everyday living with a strong sense of place, craft and contemporary comfort.',
  },
  {
    title: 'Wellness',
    body: 'Our wellness environments are calm, tactile and restorative. Treatments and rituals are reflected in materiality, lighting and flow, creating sanctuaries that feel considered rather than generic.',
  },
  {
    title: 'Curated',
    body: 'Through Curated by Skapari and partnerships with local artists, we layer authenticity into projects — sourcing artwork, objects and craft that deepen a sense of locality and leave a lasting impression.',
  },
];

const services = [
  {
    title: 'Interior Design',
    body: 'We are storytellers of interior design. After studying audience and location, we define a clear narrative and develop spaces that are intimate, layered and timeless — always in conversation with geography and history.',
  },
  {
    title: 'Project & Site Management',
    body: 'From concept through handover, we coordinate deliverables, programmes and on-site decisions so design intent survives construction. Technical know-how and acoustic experience keep projects refined, practical and on track.',
  },
  {
    title: 'FF&E Design & Specification',
    body: 'Furniture, finishes and fixtures are selected to elevate the design narrative. We work with artisans and suppliers to source beautiful, durable materials — with schedules thoroughly reviewed for design quality and buildability.',
  },
  {
    title: 'Technical Design & Documentation',
    body: 'Clear documentation and established standards help contractors deliver exceptional workmanship. Functionality comes first: ergonomics, navigation, logistics, lighting and material performance underpin every aesthetic decision.',
  },
];

const kenBurnsBands = [
  {
    src: '/images/abu-dhabi-elegance/abu-dhabi-elegance-1.jpg',
    alt: 'Abu Dhabi Elegance interiors',
  },
  {
    src: '/images/mosi-livingstone/royal-villa-terrace-zimbabwe-river-25213523.jpg',
    alt: 'Radisson Blu Mosi-oa-Tunya royal villa terrace',
  },
  {
    src: '/images/cameroon-pullman/cameroon-pullman6.jpg',
    alt: 'Radisson Hotel Yaoundé Cameroon interiors',
  },
  {
    src: '/images/projects/radisson-collection-hotel-waterfront-cape-town/radisson-collection-hotel-waterfront-cape-town-19.jpg',
    alt: 'Radisson Collection Hotel Waterfront Cape Town interiors',
  },
  {
    src: '/images/accor-office-contemporary/606ee4e80e0ed438027835.jpg',
    alt: 'Accor Office Contemporary interiors',
  },
  {
    src: '/images/projects/radisson-collection-hotel-waterfront-cape-town/radisson-collection-hotel-waterfront-cape-town-19.jpg',
    alt: 'Radisson Collection Hotel Waterfront Cape Town interiors',
  },
  {
    src: '/images/cameroon-pullman/cameroon-pullman6.jpg',
    alt: 'Radisson Hotel Yaoundé Cameroon interiors',
  },
];
---

<Layout title="Skapari - Approach" noindex>
  <div class="wrapper">
    <Nav navclass="header" />

    <section class="section" id="approach">
      <div class="container-fluid">
        <div class="overlay-content">
          <h1 class="text-right main-heading">approach</h1>
        </div>
        <ul class="mt-5 subnav nav justify-content-end">
          <li class="nav-item">
            <a class="nav-link" href="#story">story</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#people">people</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#clients">clients</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#expertise">expertise</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#services">services</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#philosophy">philosophy</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#team">team</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#curated">curated</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#recommendations">recommendations</a>
          </li>
        </ul>
      </div>
    </section>

    <section class="bg-dark section" id="story">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="d-none d-md-block col-md-4">
            <Image src={circleLightsLeft} alt="Skapari circle lights" class="img-fluid" style="max-height: 100vh" />
          </div>
          <div class="col-md-8">
            <h3 class="skapari-heading half">WE DESIGN STORIES <span>rooted in place</span></h3>
            <p class="lead-line">Our projects reside in compelling locations. Our clients are bold and inspired.</p>
            <p>
              With a passion for hospitality, Skapari creates interiors that are unobtrusive yet individual.
              Each guest — whether a business traveller or a classical tourist — should feel the attention of the hotel,
              as though the design was made specifically for them.
            </p>
            <p>
              We begin by analysing the audience and embracing the history of place. A hotel in Lagos and a hotel in
              Johannesburg cannot be taken out of their geographical and cultural context. They must be different —
              even when they welcome the same type of traveller. That sense of locality is crucial to everything we do.
            </p>
            <div class="d-block d-md-none">
              <Image src={circleLightsBottom} alt="Skapari circle lights" class="img-fluid mx-auto d-block mt-4" />
            </div>
          </div>
        </div>



        <div class="row stats-row mt-5">
          {stats.map((stat) => (
            <div class="col-6 col-lg-3 mb-4 mb-lg-0">
              <div class="stat">
                <div class="stat-value">{stat.value}</div>
                <div class="stat-rule"></div>
                <div class="stat-label">{stat.label}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="ken-burns-band" data-ken-burns aria-hidden="true">
      <div class="ken-burns-media">
        <img src={kenBurnsBands[0].src} alt={kenBurnsBands[0].alt} loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="section" id="people">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2 text-center">
            <p class="eyebrow">People</p>
            <h3 class="skapari-heading half centered">OUR DESIGNERS ARE EVERYWHERE <span>specialist hospitality minds</span></h3>
            <p class="quote">“Borderless hospitality expertise with a deep sense of place.”</p>
            <p>
              Our designers bring enviable hospitality experience across Africa and the Middle East. Project teams are
              curated to each brief — never off the rack. Specialists in hotels, apartments, wellness and FF&amp;E work
              together so every space feels considered, operational and distinctly local.
            </p>
            <p>
              Listening is a skill. We are passionate about exceeding client expectations and delivering interiors that
              are unique, bespoke and timeless.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="ken-burns-band" data-ken-burns aria-hidden="true">
      <div class="ken-burns-media">
        <img src={kenBurnsBands[1].src} alt={kenBurnsBands[1].alt} loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="bg-dark section" id="clients">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2 text-center">
            <p class="eyebrow">Clients</p>
            <h3 class="skapari-heading half centered">OUR CLIENTS ARE BRAVE AND DISCERNING <span>partnership first</span></h3>
            <p class="quote">“The moments when a client falls in love with their project make our process rewarding.”</p>
            <p>
              We work with visionary brand partners and ambitious owners who want more than a template. Relationships
              come first: we encourage client involvement throughout the process and celebrate each project as uniquely
              as the people behind it.
            </p>
            <p>
              From Radisson and Accor to independent and lifestyle destinations, we offer a tailored, attentive design
              partnership — weaving creative direction with practical delivery across the African continent and the Middle East.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="ken-burns-band" data-ken-burns aria-hidden="true">
      <div class="ken-burns-media">
        <img src={kenBurnsBands[2].src} alt={kenBurnsBands[2].alt} loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="section" id="expertise">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-12 text-center">
            <p class="eyebrow dark">Expertise</p>
            <h3 class="skapari-heading half centered">HOSPITALITY EXPERTISE <span>across typologies</span></h3>
          </div>
        </div>
        <div class="row mt-4">
          {expertise.map((item) => (
            <div class="col-md-6 mb-4">
              <div class="panel">
                <h2 class="skapari-subheading">{item.title}</h2>
                <p>{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="ken-burns-band" data-ken-burns aria-hidden="true">
      <div class="ken-burns-media">
        <img src={kenBurnsBands[3].src} alt={kenBurnsBands[3].alt} loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="bg-dark section" id="services">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2 text-center">
            <p class="eyebrow">Services</p>
            <h3 class="skapari-heading half centered">IMAGINATIVE STORYTELLING <span>creative and technical</span></h3>
            <p class="quote">“What distinguishes us is our ideation process.”</p>
          </div>
        </div>
        <div class="row mt-4">
          {services.map((item) => (
            <div class="col-md-6 mb-4">
              <div class="panel panel-dark">
                <h2 class="skapari-subheading">{item.title}</h2>
                <p>{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="ken-burns-band" data-ken-burns aria-hidden="true">
      <div class="ken-burns-media">
        <img src={kenBurnsBands[4].src} alt={kenBurnsBands[4].alt} loading="lazy" decoding="async" />
      </div>
    </section>




    <section class="section" id="team">
      <div class="container-fluid">
        <div class="row">
          <div class="col-sm-12">
            <h3 class="skapari-heading centered half">THE TEAM <span>who we are</span></h3>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-6 mx-auto">
            <div class="content">
              <p>Listening is a skill. We are passionate about our work and exceeding client expectations. We strife to deliver work of the highest standard and to create interiors that are truly unique, bespoke and timeless.</p>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-6 mx-auto">
            <Image src={jackyRiejean} alt="jacky & riejean" class="img-fluid" />
          </div>
        </div>
        <div class="row mt-5">
          <div class="col-sm-5">
            <h2 class="skapari-subheading">Jacky Greig</h2>
            <div class="content">
              <p>Jacky's spunky personality, creative genius and drive for excellence are a potent combo. She is committed to working closely with each client through the design process and consistently delivers beautiful, invigorating interiors. She has been working in the interior design industry for nearly 20 years and her immense experience is evident in the quality of work she produces for Skapari's clients.</p>
              <p>Jacky's designs are inspired by the intersection of lives and worlds that happens in multi-person spaces. Hotels offer opportunity, excitement, refuge and luxury for their guests, and the creativity and artistry Jacky brings to her work reflect these different roles a space can play in people's stories.</p>
            </div>
          </div>
          <div class="col-sm-2"></div>
          <div class="col-sm-5">
            <h2 class="skapari-subheading">Riejean Joubert</h2>
            <div class="content">
              <p>Riejean has a natural ability to bring her visions to life and to create spaces and designs that surpass expectations by finding the perfect balance in the care that she takes with clients to listen and to understand.</p>
              <p>She is committed to not only delivering incredible designs but is absolutely meticulous about achieving perfection. Riejean has been passionately involved in the hospitality design industry for over 20 years.</p>
              <p>Riejean believes that design must be pure and not overworked, with simplicity and elegance. Design must be imbued to reflect the richness of its location. Spaces must flow and work and talk to one another, spaces create an opportunity for discovery and immersion.</p>
            </div>
          </div>
          <div class="col-sm-1"></div>
        </div>
      </div>
    </section>

    <section class="ken-burns-band" data-ken-burns aria-hidden="true">
      <div class="ken-burns-media">
        <img src={kenBurnsBands[5].src} alt={kenBurnsBands[5].alt} loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="section" id="curated">
      <div class="container-fluid">
        <div class="row">
          <div class="col-sm-12">
            <h3 class="skapari-heading centered half">FINE ART<span>curated by us</span></h3>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-6 m-auto">
            <p>Dale Sargent Fine Art is a gallery as well as an online platform that offers a range of fine South African art. We have an extensive collection of artworks by established South African artists as well as works by emerging younger artists. Dale Sargent Fine Art has a gallery space in Parktown North in Johannesburg where visits are by appointment. We also offer onsite consulting and art sourcing for corporate and private clients.</p>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-6 mx-auto">
            <Image src={skapariCurated} alt="Skapari curated" class="img-fluid" />
          </div>
        </div>
        <div class="row mt-5">
          <div class="col-sm-3 mx-auto">
            <Image src={curatedLogo} alt="Skapari curated" class="img-fluid" />
          </div>
        </div>
      </div>
    </section>

    <section class="ken-burns-band" data-ken-burns aria-hidden="true">
      <div class="ken-burns-media">
        <img src={kenBurnsBands[6].src} alt={kenBurnsBands[6].alt} loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="section" id="recommendations">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-12">
            <div class="row">
              <div class="col-md-12">
                <h3 class="skapari-heading half centered">LETTERS<span>of recommendation</span></h3>
              </div>
            </div>
            <div class="row mt-5">
              <div class="col-md-3">&nbsp;</div>
              <div class="col-md-4">
                <a target="_blank" href="https://skapari.co.za/storage/app/media/Letter%20of%20Recommendation%20-%20Iain%20Cook%20Radisson.pdf">
                  <Image src={radissonLogo} height={137} width={261} class="mx-auto" alt="Radisson Logo" />
                </a>
              </div>
              <div class="col-md-4">
                <a target="_blank" href="https://skapari.co.za/storage/app/media/accor%20recommendation%20letter.pdf">
                  <Image src={accorLogo} height={128} width={227} class="mx-auto" alt="Accor Logo" />
                </a>
              </div>
              <div class="col-md-3">&nbsp;</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <Footer />
</Layout>

<script>
  function initKenBurns() {
    if (document.documentElement.dataset.kenBurnsBound === 'true') return;
    document.documentElement.dataset.kenBurnsBound = 'true';

    const bands = document.querySelectorAll('[data-ken-burns]');
    if (!bands.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const media = entry.target.querySelector('.ken-burns-media');
          if (!(media instanceof HTMLElement)) return;

          if (entry.isIntersecting && !media.classList.contains('is-playing') && !media.classList.contains('has-played')) {
            media.classList.add('is-playing');
          }
        });
      },
      {
        threshold: 0.35,
      }
    );

    bands.forEach((band) => {
      const media = band.querySelector('.ken-burns-media');
      if (media instanceof HTMLElement) {
        media.addEventListener('animationend', () => {
          media.classList.remove('is-playing');
          media.classList.add('has-played');
        });
      }
      observer.observe(band);
    });
  }

  initKenBurns();
  document.addEventListener('astro:page-load', initKenBurns);
</script>

<style>
  .lead-line {
    font-weight: 300;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 1rem;
    opacity: 0.75;
  }

  .eyebrow.dark {
    color: #0f062f;
  }

  .quote {
    font-weight: 300;
    font-style: italic;
    font-size: 1.15rem;
    margin: 1.5rem 0;
  }

  .stats-row {
    border-top: 1px solid rgba(242, 242, 242, 0.25);
    padding-top: 2.5rem;
  }

  .stat-value {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 100;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .stat-rule {
    width: 2.5rem;
    border-top: 1px solid rgba(242, 242, 242, 0.55);
    margin-bottom: 0.75rem;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.4;
    max-width: 12rem;
  }

  .panel {
    height: 100%;
    padding: 1.5rem 0;
  }

  .panel-dark .skapari-subheading {
    color: #f2f2f2;
  }

  .ken-burns-band {
    position: relative;
    height: clamp(14rem, 48vh, 26rem);
    overflow: hidden;
    background: #0f062f;
  }

  @media (min-width: 768px) {
    .ken-burns-band {
      height: clamp(28rem, 85vh, 52rem);
    }
  }

  .ken-burns-media {
    position: absolute;
    inset: -16%;
    will-change: transform;
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: 72% 70%;
  }

  .ken-burns-media.is-playing {
    animation: kenBurnsZoom 5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .ken-burns-media.has-played {
    transform: translate3d(3.5%, 2.75%, 0) scale(1.08);
  }

  @keyframes kenBurnsZoom {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(3.5%, 2.75%, 0) scale(1.08);
    }
  }

  .ken-burns-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 767.98px) {
    .skapari-heading.half.centered {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ken-burns-media,
    .ken-burns-media.is-playing,
    .ken-burns-media.has-played {
      inset: 0;
      transform: none !important;
      animation: none !important;
      will-change: auto;
    }
  }
</style>

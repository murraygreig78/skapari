---
// Convert the PHP nav.php to an Astro component
const { navclass } = Astro.props;
---

<header class={navclass}>
  <nav class="navbar" id="main-nav">
    <button class="navbar-toggler third-button ml-auto hidden-sm-up float-xs-right collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#topnavigation" aria-controls="topnavigation" aria-expanded="false" aria-label="Toggle navigation">
      <div class="animated-icon3"><span></span><span></span><span></span></div>
    </button>
    <div class="navbar-collapse collapse" id="topnavigation" style="">
      <div class="overlay-content">
        <!-- Links -->
        <ul class="mainnav navbar-nav me-auto">
          <li class="nav-item inactive">
            <a class="nav-link " href="https://skapari.co.za">home</a>
          </li>
          <li class="nav-item active">
            <a class="nav-link" href={new URL('/about', Astro.url)}>about</a>
          </li>
          <li class="nav-item inactive">
            <a class="nav-link" href={new URL('/projects', Astro.url)}>our work</a>
          </li>
          <li class="nav-item inactive">
            <a class="nav-link" href={new URL('/curated', Astro.url)}>curated</a>
          </li>
          <li class="nav-item inactive">
            <a class="nav-link" href={new URL('/contact', Astro.url)}>contact</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>


<style>
/* Mobile styles for navigation */
@media (max-width: 768px) {
  .nav-link {
    font-size: 0.9rem !important;
    padding: 0.4rem 0.8rem !important;
  }
  
  .nav-item {
    margin-bottom: 0.2rem;
  }
  
  .mainnav {
    padding: 0.5rem 0;
  }
  
  /* Subnav styles for mobile */
  .subnav .nav-link {
    font-size: 0.9rem !important;
    padding: 0.4rem 0.8rem !important;
  }
  
  .subnav .nav-item {
    margin-bottom: 0.2rem;
  }
}

@media (max-width: 480px) {
  .nav-link {
    font-size: 0.8rem !important;
    padding: 0.3rem 0.6rem !important;
  }
  
  .nav-item {
    margin-bottom: 0.1rem;
  }
  
  /* Subnav styles for small mobile */
  .subnav .nav-link {
    font-size: 0.8rem !important;
    padding: 0.3rem 0.6rem !important;
  }
  
  .subnav .nav-item {
    margin-bottom: 0.1rem;
  }
}
</style>
